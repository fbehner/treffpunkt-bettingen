# Vorlage für die .env auf dem Server (green.ch).
# Auf dem Server als DEPLOY_PATH/.env speichern und Werte in [ECKIGEN KLAMMERN] ersetzen.
# Diese Datei enthält KEINE Geheimnisse – die echte .env niemals ins Repository!

APP_NAME="Treffpunkt Bettingen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://treffpunkt-bettingen.ch
APP_TIMEZONE=Europe/Zurich

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=[MYSQL-HOST aus dem green.ch-Kundenportal]
DB_PORT=3306
DB_DATABASE=[DATENBANKNAME]
DB_USERNAME=[DATENBANKBENUTZER]
DB_PASSWORD=[DATENBANKPASSWORT]

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-Mail (z. B. für "Passwort vergessen") – Postfach bei green.ch
MAIL_MAILER=smtp
MAIL_HOST=[SMTP-HOST]
MAIL_PORT=587
MAIL_USERNAME=[POSTFACH, z. B. info@treffpunkt-bettingen.ch]
MAIL_PASSWORD=[PASSWORT]
MAIL_FROM_ADDRESS="info@treffpunkt-bettingen.ch"
MAIL_FROM_NAME="${APP_NAME}"
